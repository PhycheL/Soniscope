.dev {
  padding: 32rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.dev-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #f2f4fa;
}

.dev-sub {
  margin-top: 12rpx;
  margin-bottom: 32rpx;
  font-size: 24rpx;
  color: #6d76a0;
}

.switch {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx;
  margin-bottom: 20rpx;
  border-radius: 24rpx;
  background: rgba(26, 32, 52, 0.7);
  border: 1rpx solid rgba(90, 110, 180, 0.14);
}

.switch--on {
  border-color: rgba(59, 108, 240, 0.6);
  background: rgba(30, 44, 80, 0.85);
}

.switch-main {
  flex: 1;
  padding-right: 16rpx;
}

.switch-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #eef1f8;
}

.switch-label {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #c4cae0;
}

.switch-hint {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6d76a0;
}

.switch-state {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #6d76a0;
}

.switch-state--on {
  color: #5b86ff;
  font-weight: 600;
}

.dev--prod {
  text-align: center;
  color: #6d76a0;
  padding-top: 120rpx;
}
