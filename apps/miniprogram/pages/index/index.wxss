.record-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 80rpx;
}

.record-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background-color: #1a73e8;
  color: #ffffff;
  font-size: 36rpx;
  line-height: 1.3;
}

.record-btn--active {
  background-color: #d93025;
}

.duration {
  margin-top: 40rpx;
  font-size: 56rpx;
  font-variant-numeric: tabular-nums;
}

.nav-link {
  margin-top: 64rpx;
  color: #1a73e8;
  font-size: 28rpx;
}
