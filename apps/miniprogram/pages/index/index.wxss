/* 日观声记 · 沉浸式单屏录音样式。对应 docs/小程序原型 四态。 */

.screen {
  position: relative;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  min-height: 100vh;
  padding: 0 40rpx;
}

/* ---------- 顶部中断横幅（原型 1） ---------- */
.banner {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: linear-gradient(90deg, rgba(60, 44, 12, 0.92), rgba(38, 30, 12, 0.92));
  border: 1rpx solid rgba(214, 158, 46, 0.35);
}

.banner-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #f0b429;
  box-shadow: 0 0 12rpx rgba(240, 180, 41, 0.9);
  margin-right: 16rpx;
}

.banner-text {
  flex: 1;
  font-size: 26rpx;
  color: #f4e4c1;
}

.banner-view {
  font-size: 26rpx;
  color: #f0b429;
  padding: 4rpx 12rpx;
}

.banner-close {
  font-size: 34rpx;
  color: #9a8a6a;
  padding: 0 6rpx 0 14rpx;
  line-height: 1;
}

/* ---------- 中央录音区 ---------- */
.stage {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.timer {
  font-size: 128rpx;
  font-weight: 200;
  letter-spacing: 4rpx;
  color: #f2f4fa;
  font-variant-numeric: tabular-nums;
  margin-bottom: 40rpx;
  text-shadow: 0 4rpx 40rpx rgba(120, 150, 220, 0.25);
}

.stage-label {
  font-size: 28rpx;
  letter-spacing: 6rpx;
  color: #9fb2e6;
  margin-bottom: 60rpx;
  display: flex;
  align-items: center;
}

.stage-label--muted {
  color: #7078a0;
}

.stage-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.stage-dot--blue {
  background: #3b6cf0;
  box-shadow: 0 0 12rpx rgba(59, 108, 240, 0.9);
}

.stage-sub {
  margin-top: 64rpx;
  font-size: 26rpx;
  color: #6d76a0;
}

.stage-sub--ok {
  color: #3fae82;
}

/* ---------- 麦克风光晕按钮 ---------- */
.mic-wrap {
  position: relative;
  width: 440rpx;
  height: 440rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 双层同心光晕环（原型：外圈细描边 + 内圈发光）。 */
.ring {
  position: absolute;
  border-radius: 50%;
  border: 1rpx solid rgba(103, 132, 224, 0.35);
}

.ring-outer {
  width: 440rpx;
  height: 440rpx;
  box-shadow: 0 0 120rpx 20rpx rgba(59, 108, 240, 0.18) inset,
    0 0 80rpx rgba(59, 108, 240, 0.12);
  animation: pulse 3.4s ease-in-out infinite;
}

.ring-inner {
  width: 320rpx;
  height: 320rpx;
  border-color: rgba(103, 132, 224, 0.22);
}

/* 录音中：光晕转红。 */
.mic-wrap.is-recording .ring-outer {
  border-color: rgba(240, 70, 70, 0.4);
  box-shadow: 0 0 130rpx 24rpx rgba(230, 50, 50, 0.22) inset,
    0 0 90rpx rgba(230, 50, 50, 0.18);
  animation: pulse 1.6s ease-in-out infinite;
}

.mic-wrap.is-recording .ring-inner {
  border-color: rgba(240, 90, 90, 0.3);
}

@keyframes pulse {
  0%, 100% { transform: scale(1); opacity: 0.9; }
  50% { transform: scale(1.05); opacity: 1; }
}

.mic-btn {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 38% 32%, #5b86ff, #2f5cf0 70%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 48rpx rgba(47, 92, 240, 0.55);
}

.mic-btn--stop {
  background: radial-gradient(circle at 38% 32%, #ff6b6b, #e42f2f 70%);
  box-shadow: 0 12rpx 48rpx rgba(228, 47, 47, 0.55);
}

/* 麦克风图标（纯 CSS 绘制）。 */
.icon-mic {
  position: relative;
  width: 100rpx;
  height: 100rpx;
}

.icon-mic-cap {
  position: absolute;
  left: 50%;
  top: 14rpx;
  transform: translateX(-50%);
  width: 40rpx;
  height: 58rpx;
  border-radius: 20rpx;
  background: #ffffff;
}

.icon-mic-arc {
  position: absolute;
  left: 50%;
  top: 30rpx;
  transform: translateX(-50%);
  width: 68rpx;
  height: 54rpx;
  border: 8rpx solid #ffffff;
  border-top-color: transparent;
  border-radius: 0 0 40rpx 40rpx;
}

.icon-mic-stem {
  position: absolute;
  left: 50%;
  bottom: 4rpx;
  transform: translateX(-50%);
  width: 8rpx;
  height: 18rpx;
  background: #ffffff;
  border-radius: 4rpx;
}

/* 停止图标（白色圆角方块）。 */
.icon-stop {
  width: 56rpx;
  height: 56rpx;
  border-radius: 12rpx;
  background: #ffffff;
}

/* ---------- 底部「历史」胶囊 ---------- */
.dock {
  display: flex;
  justify-content: center;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

.pill {
  display: flex;
  align-items: center;
  padding: 18rpx 32rpx;
  border-radius: 40rpx;
  background: rgba(24, 28, 42, 0.85);
  border: 1rpx solid rgba(120, 140, 200, 0.14);
}

.pill-clock {
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  border: 3rpx solid #8a92b0;
  position: relative;
  margin-right: 14rpx;
}

.pill-clock::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  width: 8rpx;
  height: 3rpx;
  background: #8a92b0;
  transform: translate(-2rpx, -50%);
  transform-origin: left center;
}

.pill-label {
  font-size: 26rpx;
  color: #c4cae0;
}

.pill-sep {
  color: #4a5170;
  margin: 0 12rpx;
}

.pill-stat {
  font-size: 24rpx;
  margin-left: 14rpx;
}

.pill-stat--fail { color: #ff6b6b; }
.pill-stat--up { color: #5b86ff; }

/* ---------- 确认草稿播放条（原型 4） ---------- */
.confirm {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  padding: 32rpx 32rpx 36rpx;
  border-radius: 32rpx;
  background: linear-gradient(180deg, rgba(18, 22, 40, 0.98), rgba(10, 12, 24, 0.98));
  border: 1rpx solid rgba(90, 110, 190, 0.2);
  box-shadow: 0 -8rpx 60rpx rgba(0, 0, 0, 0.5);
}

.confirm-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.confirm-title {
  font-size: 24rpx;
  color: #8890b0;
  margin-bottom: 10rpx;
}

.confirm-time {
  font-size: 52rpx;
  font-weight: 300;
  font-variant-numeric: tabular-nums;
}

.confirm-time-cur { color: #f2f4fa; }
.confirm-time-tot { color: #5a6088; font-size: 40rpx; }

.confirm-play {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: radial-gradient(circle at 38% 32%, #5b86ff, #2f5cf0 70%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 28rpx rgba(47, 92, 240, 0.5);
}

.icon-play {
  width: 0;
  height: 0;
  border-style: solid;
  border-width: 18rpx 0 18rpx 30rpx;
  border-color: transparent transparent transparent #ffffff;
  margin-left: 6rpx;
}

.icon-pause {
  width: 28rpx;
  height: 32rpx;
  border-left: 10rpx solid #ffffff;
  border-right: 10rpx solid #ffffff;
  box-sizing: border-box;
}

.confirm-progress {
  height: 6rpx;
  border-radius: 3rpx;
  background: rgba(90, 100, 150, 0.25);
  margin: 28rpx 0 32rpx;
  overflow: hidden;
}

.confirm-progress-fill {
  height: 100%;
  background: #3b6cf0;
  border-radius: 3rpx;
  transition: width 0.2s linear;
}

.confirm-actions {
  display: flex;
  gap: 20rpx;
}

/* ---------- 共享按钮 ---------- */
.cbtn {
  flex: 1;
  height: 92rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 500;
}

.cbtn--ghost {
  background: rgba(40, 46, 68, 0.9);
  color: #d4d9ec;
}

.cbtn--danger {
  background: rgba(60, 24, 30, 0.9);
  color: #ff6b6b;
}

.cbtn--primary {
  background: linear-gradient(90deg, #3b6cf0, #2f5cf0);
  color: #ffffff;
  box-shadow: 0 8rpx 28rpx rgba(47, 92, 240, 0.45);
}

/* ---------- 中断恢复面板 ---------- */
.recovery-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 40;
}

.recovery-panel {
  position: fixed;
  left: 32rpx;
  right: 32rpx;
  top: 30%;
  z-index: 41;
  padding: 40rpx 36rpx;
  border-radius: 32rpx;
  background: linear-gradient(180deg, rgba(22, 26, 44, 0.99), rgba(12, 14, 26, 0.99));
  border: 1rpx solid rgba(214, 158, 46, 0.3);
}

.recovery-panel-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #f4e4c1;
  margin-bottom: 16rpx;
}

.recovery-panel-msg {
  font-size: 26rpx;
  color: #9aa0bc;
  line-height: 1.6;
  margin-bottom: 32rpx;
}

.recovery-panel-actions {
  display: flex;
  gap: 20rpx;
}

/* ---------- 历史底部弹层（原型 3） ---------- */
.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.3s ease;
  z-index: 50;
}

.sheet-mask.is-open {
  opacity: 1;
  visibility: visible;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 51;
  max-height: 82vh;
  display: flex;
  flex-direction: column;
  padding: 0 32rpx calc(40rpx + env(safe-area-inset-bottom));
  border-radius: 40rpx 40rpx 0 0;
  background: linear-gradient(180deg, #131a2e 0%, #0a0e1c 100%);
  border-top: 1rpx solid rgba(120, 140, 210, 0.18);
  transform: translateY(100%);
  transition: transform 0.34s cubic-bezier(0.22, 1, 0.36, 1);
}

.sheet.is-open {
  transform: translateY(0);
}

.sheet-grip {
  width: 72rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: rgba(150, 160, 200, 0.4);
  margin: 20rpx auto 8rpx;
}

.sheet-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 20rpx 8rpx 24rpx;
}

.sheet-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #f2f4fa;
}

.sheet-count {
  font-size: 24rpx;
  color: #6d76a0;
}

.sheet-body {
  flex: 1;
  overflow-y: auto;
}

.sheet-empty {
  padding: 100rpx 20rpx;
  text-align: center;
  color: #6d76a0;
  font-size: 26rpx;
  line-height: 2;
}

/* 历史卡片。 */
.hcard {
  display: flex;
  align-items: center;
  padding: 26rpx 28rpx;
  margin-bottom: 20rpx;
  border-radius: 24rpx;
  background: rgba(26, 32, 52, 0.7);
  border: 1rpx solid rgba(90, 110, 180, 0.12);
}

.hcard--fail {
  border-color: rgba(255, 90, 90, 0.3);
}

.hcard--session {
  flex-direction: column;
  align-items: stretch;
}

.hcard-head {
  display: flex;
  align-items: center;
}

.hcard-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 22rpx;
  flex-shrink: 0;
}

.hcard-dot--up { background: #3b6cf0; box-shadow: 0 0 10rpx rgba(59, 108, 240, 0.8); }
.hcard-dot--ok { background: #2fd08a; box-shadow: 0 0 10rpx rgba(47, 208, 138, 0.8); }
.hcard-dot--fail { background: #ff5a5a; box-shadow: 0 0 10rpx rgba(255, 90, 90, 0.8); }

.hcard-main {
  flex: 1;
  min-width: 0;
}

.hcard-title {
  font-size: 32rpx;
  color: #eef1f8;
  margin-bottom: 8rpx;
}

.hcard-sub {
  font-size: 24rpx;
  color: #6d76a0;
}

.hcard-toggle {
  font-size: 24rpx;
  color: #5b86ff;
}

.hcard-retry {
  padding: 12rpx 28rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #ff6b6b;
  background: rgba(60, 24, 30, 0.9);
  flex-shrink: 0;
}

.hcard-chunks {
  margin-top: 20rpx;
  border-top: 1rpx solid rgba(90, 110, 180, 0.12);
  padding-top: 8rpx;
}

.hchunk {
  display: flex;
  align-items: center;
  padding: 18rpx 4rpx;
}

.hchunk-title {
  font-size: 28rpx;
  color: #d4d9ec;
  margin-bottom: 4rpx;
}

.sheet-dev {
  margin: 20rpx 0 8rpx;
  padding: 16rpx;
  text-align: center;
  font-size: 24rpx;
  color: #5a6288;
}
