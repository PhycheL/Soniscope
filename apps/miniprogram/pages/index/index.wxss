.record-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 80rpx;
}

.record-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 280rpx;
  height: 280rpx;
  border-radius: 50%;
  background-color: #1a73e8;
  color: #ffffff;
  font-size: 36rpx;
  line-height: 1.3;
}

.record-btn--active {
  background-color: #d93025;
}

.duration {
  margin-top: 40rpx;
  font-size: 56rpx;
  font-variant-numeric: tabular-nums;
}

.draft {
  margin: 56rpx 32rpx 0;
  padding: 28rpx 32rpx;
  background-color: #f1f3f4;
  border-radius: 16rpx;
}

.draft-title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.draft-row {
  font-size: 26rpx;
  color: #3c4043;
  line-height: 1.8;
}

.draft-row--mono {
  font-family: "SFMono-Regular", Menlo, monospace;
  word-break: break-all;
}

.draft-note {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #80868b;
  line-height: 1.5;
}

.draft-actions {
  display: flex;
  flex-wrap: wrap;
  margin-top: 24rpx;
}

.draft-btn {
  flex: 1 1 30%;
  margin: 8rpx;
  font-size: 26rpx;
  color: #3c4043;
  background-color: #ffffff;
}

.draft-btn--primary {
  flex-basis: 100%;
  color: #ffffff;
  background-color: #1a73e8;
}

.draft-btn--danger {
  color: #d93025;
}

.draft-frozen {
  margin-top: 24rpx;
  font-size: 24rpx;
  color: #188038;
}

.recovery {
  margin: 56rpx 32rpx 0;
  padding: 28rpx 32rpx;
  background-color: #fef7e0;
  border: 1rpx solid #f9ab00;
  border-radius: 16rpx;
}

.recovery-msg {
  font-size: 28rpx;
  color: #5f6368;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.recovery-actions {
  display: flex;
  justify-content: space-between;
}

.recovery-btn {
  flex: 1;
  margin: 0 8rpx;
  font-size: 26rpx;
  color: #ffffff;
}

.recovery-btn--keep {
  background-color: #1a73e8;
}

.recovery-btn--discard {
  background-color: #d93025;
}

.recovery-btn--restart {
  background-color: #188038;
}

.hint {
  margin: 56rpx 32rpx 0;
  font-size: 26rpx;
  color: #80868b;
  text-align: center;
}

.nav-link {
  margin-top: 64rpx;
  color: #1a73e8;
  font-size: 28rpx;
}
