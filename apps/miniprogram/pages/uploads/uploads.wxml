<view class="container">
  <view wx:if="{{items.length === 0}}" class="empty">
    暂无录音。回到「录音」页开始第一条录音。
  </view>
  <view wx:else class="list">
    <view wx:for="{{items}}" wx:key="fragmentId" class="item">
      <view class="item-main">
        <text class="item-id">{{item.fragmentId}}</text>
        <text class="item-status">{{item.statusText}}</text>
      </view>
      <view class="item-meta">
        <text wx:if="{{item.status === 'uploading'}}" class="item-progress">{{item.progress || 0}}%</text>
        <text wx:if="{{item.errorCode}}" class="item-error">{{item.errorCode}}</text>
        <text wx:if="{{item.reason}}" class="item-error">{{item.reason}}</text>
        <text wx:if="{{item.localDeleted}}" class="item-note">本地缓存已清理（OSS 仍保留）</text>
      </view>
      <view class="item-actions">
        <button
          wx:if="{{item.status === 'pending_verify' || item.status === 'manual_verify'}}"
          class="item-btn"
          size="mini"
          data-fid="{{item.fragmentId}}"
          bindtap="onTapReVerify"
        >重新 verify</button>
        <button
          class="item-btn item-btn--danger"
          size="mini"
          data-fid="{{item.fragmentId}}"
          bindtap="onTapDelete"
        >删除</button>
      </view>
    </view>
  </view>
</view>
