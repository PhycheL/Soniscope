/* 日观声记 · 上传列表页样式 */

.container {
  padding: 20px;
  min-height: 100vh;
}

.page-title {
  font-size: 20px;
  font-weight: 600;
  margin-bottom: 20px;
}

.empty-list {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 100px;
}

.empty-text {
  font-size: 16px;
  color: #999999;
  margin-bottom: 8px;
}

.empty-hint {
  font-size: 14px;
  color: #cccccc;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.list-item {
  background-color: #ffffff;
  border-radius: 12px;
  padding: 16px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
}

.item-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.item-id {
  font-size: 14px;
  color: #333333;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-status {
  font-size: 13px;
  padding: 4px 10px;
  border-radius: 12px;
  background-color: #f0f0f0;
  margin-left: 12px;
  flex-shrink: 0;
}

/* 状态颜色 */
.item-status.draft { background-color: #f5f5f5; color: #999999; }
.item-status.queued { background-color: #fff7e6; color: #fa8c16; }
.item-status.uploading { background-color: #e6f7ff; color: #1890ff; }
.item-status.pending_verify { background-color: #f6ffed; color: #52c41a; }
.item-status.verified { background-color: #f6ffed; color: #52c41a; }
.item-status.upload_failed { background-color: #fff1f0; color: #f5222d; }
.item-status.manual_retry { background-color: #fff1f0; color: #f5222d; }
.item-status.manual_verify { background-color: #fff7e6; color: #fa8c16; }

.item-meta {
  font-size: 13px;
  color: #999999;
}

.nav-section {
  margin-top: 40px;
  text-align: center;
}

.nav-link {
  color: #07c160;
  font-size: 14px;
}
