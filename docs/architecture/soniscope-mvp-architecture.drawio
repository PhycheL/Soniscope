        <mxCell id="evidence" value="代码证据&lt;br&gt;&lt;font style=&quot;font-size: 13px;&quot;&gt;Mini Program: apps/miniprogram/app.js, pages/index/index.js, utils/uploader.js, pages/upload-list/upload-list.js&lt;br&gt;FC: apps/fc/shared/app.py, apps/fc/issue_credential/handler.py, apps/fc/verify_upload/handler.py, apps/fc/shared/fc_shared/auth.py, sts.py, head.py&lt;br&gt;Worker: apps/worker/src/soniscope_worker/poller.py, audio.py, manifest.py, transcriber.py, nls_transcriber.py, paths.py&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;fontSize=15;fontStyle=1;align=left;verticalAlign=top;spacing=12;fontFamily=Noto Sans JP;" vertex="1" parent="1">
